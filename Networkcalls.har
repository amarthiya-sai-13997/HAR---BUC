          "content": {
            "size": 20947,
            "mimeType": "text/html",
            "compression": 16048,
            "text": "\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">\n\n<script language=\"JavaScript\" type=\"text/javascript\" src=\"/js/framework/jquery.floatThead.min.js?v=12792180\"></script><html><script nonce=\"QXMnLSfOTxKIccK4/cAOow==\">function copySingleObject(objectIndexId) {\n$('#csvLoadingDiv').show();\t\t//NO I18N\n$('#csvLoadingContent').html(FcLayoutTexts.copyRowText);\t//NO I18N\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=copySingleObject\", PARAMETERS:\"objectIndexId=\"+objectIndexId+\"&uid=\"+FcBulkLayoutDetails.beanId, ONSUCCESSFUNC:showMgmtOperationStatus }); //NO I18N\n}\nfunction deleteObjectConfirmMsg(objectIndexId) {\n//In workflow we wont allow to remove all the object from request (if need we can delete/reject the request).. so if it workflowpage, we should not allow to delete all the users.\n//it includes columnheading also..so subtracting -1 from total tr count\nvar userCounts = $('#detailsTable tr').length - 1;// NO I18N  \nif(FcBulkLayoutDetails.isWorkFlowPage && userCounts == 1) {\nDWRUtil.getMessageString(\"admp.workflow.view_request.text.you_cannot_remove_all_obj_from_request\",\"\",loc,function(message){\nADMPAlert.alert(message);});\nreturn ;\n}\nDWRUtil.getMessageString(\"admp.mgmt.fc_layout_common.confirm_want_to_delete_the_row\",\"\",loc,function(message){\nvar callBackSuccess = function() { deleteSingleObject(objectIndexId); };\nADMPAlert.confirm(message, null, callBackSuccess);\n});\n}\nfunction deleteSingleObject(objectIndexId) {\nif(!FcBulkLayoutDetails.isWorkFlowPage) {\n$('#csvLoadingDiv').show();\t\t//NO I18N\n$('#csvLoadingContent').html(FcLayoutTexts.deleteRowText);\t//NO I18N\n}\nvar params = \"objectIndexId=\"+objectIndexId+\"&isWorkFlowMode=\"+FcBulkLayoutDetails.isWorkFlowMode;//NO I18N\nparamsJsonStr = getCommonJSON();\n/*getCommonJSON() -  this function implemented in Workflow module only, after request raised if any board member try to change the request data then for auditing we should track these information. For that purpose we send some basic workflow request info like requestId, taskId... where as in layout module we didnt write any implementation for this api. defined in FcBulkInit.jsp*/\nif(paramsJsonStr != undefined) {\nparams += paramsJsonStr;\n}\nif($('#idUsedToDetectEmber').length>0){\nViewRequest.deleteObjOperation = true;\t//this is used in workflow buc request (ViewRequest.js)\n}\nparams += \"&uid=\" + FcBulkLayoutDetails.beanId;      //NO I18N\nFcBulkLayoutDetails.selectedList.remove(objectIndexId);\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=deleteSingleObject\", PARAMETERS:params, ONSUCCESSFUNC:showMgmtOperationStatus, OBJECT_INDEX_ID:objectIndexId }); //NO I18N\n}\nfunction editObject(objectIndexId){\nif(typeof ViewRequest!='undefined'){\nViewRequest.editSingleObject(objectIndexId);\n}\nelse{\neditSingleObject(objectIndexId);\n}\n}\nfunction showMgmtOperationStatus(response, reqOptions) {\nvar jsonObject = response.transport;    \nvar ajaxResult = JSON.parse(jsonObject.responseText);\nvar statusVar = ajaxResult[\"status\"];\nvar statusMsg = ajaxResult[\"statusMsg\"];\nif(statusVar) {\nif(!FcBulkLayoutDetails.isWorkFlowPage)\n{\t\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=getObjectDetails\", PARAMETERS:\"uid=\"+FcBulkLayoutDetails.beanId, ONSUCCESSFUNC:fillObjectDetailsWithStatusMsg, STATUS_MSG:statusMsg}); //NO I18N\n}\nelse \n{\nvar objectIndexId = reqOptions[\"OBJECT_INDEX_ID\"];\n$('#'+objectIndexId+'_row').remove();\t\t//NO I18N\n$('#status_success_div').text(statusMsg);\t//NO I18N\n$('#MessageDiv').hide();\t\t//NO I18N\n$('#MessageDiv').slideDown('slow');\t//NO I18N\n}\t\n}\nif(FcBulkLayoutDetails.isWorkFlowMode)\nViewRequest.getObjectAudit();\n}\nfunction fillObjectDetailsWithStatusMsg(response, reqOptions) {\n$('#csvLoadingDiv').hide();\t\t//NO I18N\n$('#csvLoadingContent').html('');\t//NO I18N\nvar parsedHtml = $('<div>').html(response.responseText);\nparsedHtml.find('script').each(function () {\n$(this).attr('nonce', cspUtils.getCurrentNonce()); //NO I18N\n});\n$('#objectDetailsArea').html(parsedHtml.html());\t//NO I18N\nFcBulkLayoutDetails.updateNavigationBarDetails();\nFcBulkLayoutDetails.updateValidationStatusColumn();\nif(FcBulkLayoutDetails.totalCount>0) {\nvar statusMsg = reqOptions[\"STATUS_MSG\"];\n$('#navigationBarStatusMsgContent').text(statusMsg);\t//NO I18N\n$('#navigationBarStatusMsgDiv').hide();\t\t//NO I18N\n$('#navigationBarStatusMsgDiv').slideDown('slow');\t//NO I18N\nresetBulkLayout();\nFcBulkLayoutDetails.updateMgmtOperationButtons();\n}\n}\nfunction fillResetLayoutResponse(response,reqOptions){\nvar parsedHtml = $('<div>').html(response.responseText);\nparsedHtml.find('script').each(function () {\n$(this).attr('nonce', cspUtils.getCurrentNonce()); //NO I18N\n});\n$('#IntroductionDiv').html(parsedHtml.html());\t//NO I18N\n}\nfunction resetBulkLayout(){\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=getCSVImportErrorDetails\", PARAMETERS: \"isReset=true\"+\"&uid=\"+FcBulkLayoutDetails.beanId, ONSUCCESSFUNC:fillResetLayoutResponse}); //NO I18N\n}\nvar processStarted = false;\nfunction onBlurAction(objectIndexId, ldapName, attribDisplayName, attribProperties,containerName)\n{\nif(processStarted) return;\nsaveField(objectIndexId, ldapName, attribDisplayName, attribProperties,containerName);\n}\nfunction onKeyPressAction(event, objectIndexId, ldapName, attribDisplayName, attribProperties,containerName)\n{\nif(event && (event.keyCode== 13 || event.which == 13)) \n{\nsaveField(objectIndexId, ldapName, attribDisplayName, attribProperties,containerName);\n//In IE, the same event passes to ADMPAlert.js's ok button and alert will be closed immediately. To avoid this, event propagation is stopped. IE10 compatability mode supports returnValue.\nif(event.preventDefault) \n{\nevent.preventDefault();\t\n}\nelse \n{\nevent.returnValue = false;\n}\n} \nelse if(event && (event.keyCode== 27 || event.which == 27)) \n{\ncancelEditField(objectIndexId, ldapName);\t\t\t\t\t\t\n}\t\n}\nfunction saveField(objectIndexId, ldapName, attribDisplayName, attribProperties,containerName) \n{\nvar value = $('#'+objectIndexId+'_'+ldapName+'_TextBox').val();\t\t//NO I18N\nvar oldValue = $('#'+objectIndexId+'_'+ldapName+'_anchor').text();\t\t//NO I18N\nprocessStarted = true;\nif(jQuery.trim(value).length == 0) \n{\nDWRUtil.getMessageString(\"admp.mgmt.user_mgmt.cre_bulk_user.alert_please_enter_some_text\",\"\",loc,function(message, objectIndexId, ldapName){\nADMPAlert.alert(message); \n});//NO I18N\ncancelEditField(objectIndexId, ldapName);\n}\nelse if(FcBulkLayoutDetails.authorizationField.contains(ldapName)){\t\n//for other than ouName no need check authorization for given value.\ncheckAuthorization(objectIndexId,ldapName,value,oldValue);\ncancelEditField(objectIndexId, ldapName);\n}\nelse if(FcBulkLayoutDetails.validateEditFields(attribProperties, attribDisplayName, value))\n{\n//AjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=editField\", PARAMETERS:\"objectIndexId=\"+objectIndexId+'&ldapName='+ldapName+'&value='+encodeURIComponent(value)+\"&isWorkFlowMode=\"+FcBulkLayoutDetails.isWorkFlowMode+\"&isWorkFlowPage=\"+FcBulkLayoutDetails.isWorkFlowPage, ONSUCCESSFUNC:replaceEditedObjectRow, OPSTATUSID:\"loadingDiv\",\tOPSTATUSTYPE:\"\", OPSTATUSMESSAGE: \"Loading ...\", OPSTATUSLOADINGCLASS: \"loadingmessage\", OPSTATUSLOADEDCLASS: \"loadedmessage\", STATUSMSGID :\"attribStatusTable\", OBJECTINDEXID:objectIndexId }); //NO I18N\nupdateFieldVaue(objectIndexId,ldapName,value,oldValue,containerName);\ncancelEditField(objectIndexId, ldapName, true);\n}\nelse\n{\ncancelEditField(objectIndexId, ldapName);\n}\nsetTimeout(() => { setProcessStarted(); }, 100);\n}\nfunction updateFieldVaue(objectIndexId,ldapName,value,oldValue,containerName){\nparamsJsonStr = getCommonJSON();\n/*getCommonJSON() -  this function implemented in Workflow module only, after request raised if any board member try to change the request data then for auditing we should track these information. For that purpose we send some basic workflow request info like requestId, taskId... where as in layout module we didnt write any implementation for this api. defined in FcBulkInit.jsp*/\nvar inputDetailsParamsJsonStr = \"&inputDetails={\";//NO I18n\ninputDetailsParamsJsonStr += \"\\\"oldValue\\\":\\\"\"+encodeURIComponent(oldValue)+\"\\\"\";//NO I18N\ninputDetailsParamsJsonStr += \"}\";\nvar params = \"objectIndexId=\"+objectIndexId+'&ldapName='+ldapName+'&value='+encodeURIComponent(value)+\"&isWorkFlowMode=\"+FcBulkLayoutDetails.isWorkFlowMode+\"&isWorkFlowPage=\"+FcBulkLayoutDetails.isWorkFlowPage;//NO I18N\nif(paramsJsonStr != undefined){\nparams += paramsJsonStr;\n}\nparams += inputDetailsParamsJsonStr+\"&CONTAINER_NAME=\"+containerName + \"&uid=\" + FcBulkLayoutDetails.beanId;//NO I18n\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=editField\", PARAMETERS:params, ONSUCCESSFUNC:replaceEditedObjectRow, OPSTATUSID:\"loadingDiv\",\tOPSTATUSTYPE:\"\", OPSTATUSMESSAGE: \"Loading ...\", OPSTATUSLOADINGCLASS: \"loadingmessage\", OPSTATUSLOADEDCLASS: \"loadedmessage\", STATUSMSGID :\"attribStatusTable\", OBJECTINDEXID:objectIndexId }); //NO I18N\n}\nfunction checkAuthorization(objectIndexId,ldapName,value,oldValue)\n{\nAjaxAPI.sendRequest({URL:\"/BulkExecuteForm.do?methodToCall=checkAuthorization\", PARAMETERS:\"ldapName=\"+ldapName+\"&value=\"+encodeURIComponent(value), ONSUCCESSFUNC:checkAuthorizationSuccess, OPSTATUSID:\"loadingDiv\",\tOPSTATUSTYPE:\"\", OPSTATUSMESSAGE: \"Loading ...\", OPSTATUSLOADINGCLASS: \"loadingmessage\", OPSTATUSLOADEDCLASS: \"loadedmessage\", STATUSMSGID :\"attribStatusTable\", OBJECTINDEXID:objectIndexId, LDAPNAME:ldapName,VALUE:value,OLDVALUE:oldValue}); //NO I18N\n}\nfunction checkAuthorizationSuccess(response, reqOptions) {\nvar jsonObject = response.transport;    \nvar ajaxResult = JSON.parse(jsonObject.responseText);;\nvar statusVar = ajaxResult[\"status\"];\nvar statusMsg = ajaxResult[\"statusMsg\"];\nvar objectIndexId = reqOptions[\"OBJECTINDEXID\"];\nvar ldapName = reqOptions[\"LDAPNAME\"];\nvar value = reqOptions[\"VALUE\"];\nvar oldValue = reqOptions[\"OLDVALUE\"];\nif(statusVar) {\nupdateFieldVaue(objectIndexId,ldapName,value,oldValue,\"\");\n}\nelse \n{\n$('#navigationBarStatusMsgContent').text(statusMsg);\t//NO I18N\n$('#navigationBarStatusMsgDiv').hide();\t\t//NO I18N\n$('#navigationBarStatusMsgDiv').slideDown('slow');\t//NO I18N\n}\t\n}\nfunction cancelEditField(objectIndexId, ldapName, updateNewValue) \n{\nif(updateNewValue != undefined && updateNewValue)\n{\nvar newValue = $('#'+objectIndexId+'_'+ldapName+'_TextBox').val();\t//NO I18N\n$('#'+objectIndexId+'_'+ldapName+'_anchor').text(newValue);\t\t//NO I18N\n}\nelse\n{\nvar oldValue = $('#'+objectIndexId+'_'+ldapName+'_anchor').text();\t\t//NO I18N\n$('#'+objectIndexId+'_'+ldapName+'_TextBox').val(oldValue);\t//NO I18N\t\t\t\n}\n$('#'+objectIndexId+'_'+ldapName+'_TextBox').blur(); //No I18N\n$('#'+objectIndexId+'_'+ldapName+'_Display').show();\t//NO I18N\n$('#'+objectIndexId+'_'+ldapName+'_Edit').hide();\t//NO I18N\t\t\n}\nfunction setProcessStarted()\n{\nprocessStarted = false;\n}\nfunction replaceEditedObjectRow(response, reqOptions) {\nvar objectIndexId = reqOptions[\"OBJECTINDEXID\"];\nvar parsedHtml = $('<div>').html(response.responseText);\nparsedHtml.find('script').each(function () {\n$(this).attr('nonce', cspUtils.getCurrentNonce()); //NO I18N\n});\n$('#'+objectIndexId+'_row').html(parsedHtml.html());\t//NO I18N\nif(FcBulkLayoutDetails.isModification)\n{\n$('#selectCheckBox_'+objectIndexId).iCheck({\ncheckboxClass: 'iCheck icheckbox_minimal', // NO I18N\nincreaseArea: '20%'\n});\n$('#selectCheckBox_'+objectIndexId).on(\"ifChanged\",function(e) {FcBulkLayoutDetails.selectObject(this);});\nFcBulkLayoutDetails.updateSelectedListToUI();\n}\n//if(!FcBulkLayoutDetails.isWorkFlowPage)\nFcBulkLayoutDetails.updateValidationStatusColumn();\nif(FcBulkLayoutDetails.isWorkFlowMode)\nViewRequest.getObjectAudit();\n}\nfunction editField(objectIndexId, ldapName) {\n$('#'+objectIndexId+'_'+ldapName+'_Display').hide();\t//NO I18N\n$('#'+objectIndexId+'_'+ldapName+'_Edit').show();\t//NO I18N\n$('#'+objectIndexId+'_'+ldapName+'_TextBox').focus();\t//NO I18N\n}\nfunction showHideDiv(element)\n{\nvar e = document.getElementById(element);\nvar image = document.getElementById(element + \"Image\");\nif(e.style.display == 'none')\n{\ne.style.display = 'block';\nimage.src = '/images/layout_trminus.png';\n}\nelse\n{\ne.style.display = 'none';\nimage.src = '/images/layout_trplus.png';\n}\n}\nfunction getUserModifyPreview(objectIndexId) {\n$(\"#objectContentDetailsDiv\").children(\".freeze\").show(); //NO I18N\nlet param = new URLSearchParams({\nobjectIndexId: objectIndexId,\ndomainName: ViewRequest.domainName,\nuid: FcBulkLayoutDetails.beanId,\ntemplateCategoryId: FcBulkLayoutDetails.templateCategoryId,\nmode: FcBulkLayoutDetails.isWorkFlowMode,\n}).toString();\nAjaxAPI.sendRequest({\nURL: \"WorkFlow.do?methodToCall=getUserModifyPreview\", //NO I18N\nPARAMETERS: param,\nONSUCCESSFUNC: getUserModifyPreviewHandler,\n});\n}\nfunction getUserModifyPreviewHandler(response, reqOptions) {\nlet param = Object.fromEntries(new URLSearchParams(reqOptions.PARAMETERS).entries());\nlet currentObjIdxId = $(\"table#detailsTable tr.current\").attr(\"data-objectIndexId\"); //NO I18N\nif (currentObjIdxId == param.objectIndexId) {\n$('#preview-div').html(response.responseText);\n$('#loading-div').hide();\n}\n}</script>\n<div id=\"objectContentDetailsDiv\"  class=\"scroll-table admp-h-300 admp-make-relative admp-overflow-auto\"><div><table id=\"detailsTable\" class=\"table admp-table target_class  alt-table scroll-table-body \">\n<thead> <tr><th id=\"actionHeader\" class=\"admp-nowrap\"> \n<span class=\"graytxtbold admp-make-inline-block admp-w-50\"> Action </span><span class=\"graytxtbold \" id=\"validationStatusHeader\" style=\"display:none\">Validatio