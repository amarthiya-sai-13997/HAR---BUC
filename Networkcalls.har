          "content": {
            "size": 4666,
            "mimeType": "text/javascript",
            "compression": 2917,
            "text": "/*\n *$Id$\n */\n \nvar WAADBulkMgmtThreadHandler = function(){\n\tthis.timeInterval = 1000;\n}\n\nWAADBulkMgmtThreadHandler.prototype.initialize = function(){\n\tViewHandler.setTimerObject(new TimerObject(WAADBulkMgmtThreadHandler.updateResult,WAADBulkMgmtThreadHandler.callback,this.timeInterval));\n\tViewHandler.initOneTimeThread();\n\t$('#operationStatusDiv').show();\n}\n\nWAADBulkMgmtThreadHandler.updateResult = function(){\n\tvar url = \"/WAADBulkMgmt.do?methodToCall=getDynamicUpdateDetails\";\n\tAjaxAPI.sendRequest({URL:url,PARAMETERS:\"params=\"+RVReqParams.getClientThreadTableViewJSON(), ONSUCCESSFUNC:WAADBulkMgmtThreadHandler.updateTableViewDetails, ONFAILUREFUNC: ThreadHandler.ajaxFailure});//NO I18N\n}\n\n//Json will have the details of latest 25 rows..In StatusUpdator,new rows will inserted to index 0.\n//iterate from last..If row doesnot exists,add row at first..\n//After adding if more than 25 rows exists, remove last row..\n\nWAADBulkMgmtThreadHandler.updateTableViewDetails = function(response, reqOptions){\n\tvar jsonText = response.responseText;\n\t\n\tdashBoardDetails = JSON.parse(jsonText);\n\tdetails = dashBoardDetails.filterDetails;\n\t\n\tViewHandler.checkNotifierVariable(dashBoardDetails.isCompleted);\n\t\n\t// Even there is no content, we should show empty page.. Just without staus_message, atleaset need to display header columns..\n\t$('#rvlist_'+rvDO.currentRVObject.rvId).show();\n\t$('#result_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).show();\t\n\n\tif(!dashBoardDetails.isCompleted)\n\t{\n\t\t// var currentCount = Number($('#modifiedOBjCount').text());\n\t\t$('#mgmtOBjCount').text(dashBoardDetails.count);\t//NO I18N\n\t\tfor(var index=0; index<details.length; index++)\n\t\t{\t\n\t\t\tjson = details[index];\n\t\t\t$('#bottomNavigation_'+json.filterId).hide();\n\t\t\t$('#header_'+json.filterId).hide();\n\n\t\t\t$('#objectCreationCount').html(json.count);//NO I18N\n\n\t\t\tWAADBulkMgmtThreadHandler.updateTableRows(json.filterId,json.rowData);\n\t\t\tvar isCsvMgmt = $.parseJSON(rvDO.customParams).isCsvMgmt;\n\t\t\tif(!isCsvMgmt)\n\t\t\t\t$(\"#resultTableList_\"+json.filterId +\" tr:odd\").attr(\"class\", \"rowtable2\");\n\t\t\telse\n\t\t\t\t$(\"#csvResultTableList_\"+json.filterId +\" tr:odd\").attr(\"class\", \"rowtable2\");\n\t\t}\n\t\t$('#statusDiv').html(dashBoardDetails.statusMessage);//NO I18N\n\t\tResultViewDataModel.initClientThread();\n\t}else\n\t{\n\t\t$('#rvlist_'+rvDO.currentRVObject.rvId).show();\t\n\t\t$('#result_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).show();\n\t}\n}\nWAADBulkMgmtThreadHandler.updateTableRows = function(filterId,rowsList){\n\tvar isCsvMgmt = $.parseJSON(rvDO.customParams).isCsvMgmt;\n\tfor(var index=rowsList.length-1; index>-1;index--){\t\t//Adding from end..\n\t\trowObj = rowsList[index];\n\t\tif(!isCsvMgmt)\n\t\t\ttableObj = $(\"#resultTableList_\"+filterId);\n\t\telse\n\t\t\ttableObj = $(\"#csvResultTableList_\"+filterId);\n\t\ttableObj.each(function(){\n\t\t\tvar $table = $(this);\n\t\t\tvar objectIndexId = rowObj[0];\n\t\t\tif(!document.getElementById(objectIndexId + \"_Row\"))\n\t\t\t{\n\t\t    \t\tvar n = $('tr:first td', this).length;\n\t \t\t    \tvar newRowHtml = '<tr height=\\\"25\\\" class=\\\"rowtable1\\\" id=\\\"'+objectIndexId+'_Row\\\">';\n\t\t\t\n\t\t\t\tif(!isCsvMgmt) {\n\t\t\t\t\tvar attribIdList = rvDO.currentRVObject.currentSubTabObject.currentViewObject.attributeIdList;\n\t\t\t\t\t\n\t\t\t\t\tfor(var i=0;i<attribIdList.length;i++){\n\t\t\t\t\t\tvar columnValue = rowObj[i];\n\t\t\t\t\t\tnewRowHtml += '<td id=\\\"Col_'+objectIndexId+'_'+i+'\\\" align=\\\"left\\\">'+columnValue +'</td>';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse {\n\t\t\t\t\tvar headerJsonArray = $.parseJSON(rvDO.customParams).headerJsonArray;\n\t\t\t\t\tvar i=0;\n\t\t\t\t\tfor(;i<headerJsonArray.length;i++) {\n\t\t\t\t\t\tvar columnValue = rowObj[i];\n\t\t\t\t\t\tnewRowHtml += '<td id=\\\"Col_'+objectIndexId+'_'+i+'\\\" align=\\\"left\\\">'+columnValue +'</td>';\n\t\t\t\t\t}\n\t\t\t\t\tnewRowHtml += '<td id=\\\"Col_'+objectIndexId+'_'+i+'\\\" align=\\\"left\\\">'+rowObj[i] +'</td>';\t//to append status message in UI\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tnewRowHtml += '</tr>';\n\t\t\t\t  if($('.delayedTaskTableHeader').length)\n\t\t\t\t  \t$('.delayedTaskTableHeader').after(newRowHtml);\t\t\t//inserting after header row.\n\t\t\t\t  else\n\t    \t\t\t$('.columnheaderbg').after(newRowHtml);\t\t\t//inserting after header row.\n\t\t\t\tvar rowCount = $('tr',this).length;\n\t\t\t\tif(rowCount>26)\n\t\t\t\t\t$('tr:last').remove();\t\t\t\t\t//Removing lastrow..\n\t\t\t\t\t\n\t\t\t}\n\t\t});\n\t}\n}\nWAADBulkMgmtThreadHandler.callback = function() \n{\n\tif(ViewHandler.isAlive){\n\t}else{\n\t\t$('#rvHeader').hide();\n\t\t$('#loadingDiv').hide();\n\t\t$('#stopModification').hide();\n\t\t$('#operationStatusDiv').hide();\n\t\t$('#countDiv').hide();\n\t\t$('#submitdiv').hide();\n\t\t$('#MoreActionsDiv').show();\n\t\tResultViewDataModel.updateReportRunningStatus(false);\n\t\t//ResultViewDataModel.checkMgmtResult();\n\t\tResultViewDataModel.showMgmtResultView();\n\t}\n}"
          },
