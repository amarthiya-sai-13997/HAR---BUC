          "content": {
            "size": 44038,
            "mimeType": "text/javascript",
            "compression": 35323,
            "text": "/*\n *$Id$\n */\nvar rvDO;\nvar selOUs = [];\nvar WAADMgmtHandler = new function(){}\n\nWAADMgmtHandler.init = function(reportId, scriptHandler, actionClassName, rvcID, showInputDetail, licenserestricted,popupText) {\n\tthis.reportId = reportId;\n\t\n\t// we can provide all the values here based on the reportId, then for each reportId, this can be configured. So that the corresponding methods will be called.. Need to Initialize the threadhandler also with this information..\n\tthis.url = '';\n\tthis.methodToCall = '';\n\tthis.scriptMgmtHandler = scriptHandler;\t//NO I18N\n\tthis.mgmtActionClass = actionClassName;\t//NO I18N\n\tthis.rvcId = rvcID;\n\tthis.showInputDetails = showInputDetail;\n\tthis.showHeaderOnEmptySearchResults = true;\n\tthis.licenseRestricted = licenserestricted;\n\tthis.onTheFlyMgmtDetails = '';\n\tthis.selectO365PropsText = popupText;\n}\n\nWAADMgmtHandler.reInit = function() {\n\t/* The reportId and other related variables will not be chnaged. Hence not handled here.. */\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.reInitSelectedObjects();\n}\n\nWAADMgmtHandler.loadCVC = function(cvId, dataId, actionId, waadAccountSelectionInput)\n{\n\tCVC.loadJS();\n\tWAADMgmtHandler.cvcDataId = dataId;\n\tvar successFunc=\"WAADMgmtHandler.UIHandler\";\t\t\t//NO I18N\t\n\tvar cvcId = cvId;\n\tCVC.loadCVC({CVC_ID:cvcId, CVC_DATA_ID:WAADMgmtHandler.cvcDataId, DIV_ID:\"BUMMgmtCVCDivId\", ACTION_ID:actionId, CUSTOM_PARAMS:waadAccountSelectionInput, ONSUCCESSFUNC:successFunc}); //NO I18n\n}\n\nWAADMgmtHandler.UIHandler = function()\n{\n\tCVC.doPostReportAction();\t// what is happening here?\n}\n\nWAADMgmtHandler.isPageValid = function() {\n\tvar returnValue = true;\n\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount)==0) {\n\t\treturnValue = false;\n\t\tDWRUtil.getMessageString(\"admp.reports.user_reports.common.alert.select_users\",\"\",loc,function(message){ADMPAlert.alert(message);});\n\t}\n\tif(returnValue) {\n\t\t// ToDo - If multiple Mgmt operation is made to use this js, then we can check the reportId to validate different Actions..\n\t\treturnValue = window[WAADMgmtHandler.scriptMgmtHandler].hasValidValue();\n\t\tif(!returnValue) {\n\t\t\tif($('#toggleCVCDisplayDiv').hasClass('close')) {\n\t\t\t\ttoggleInputDiv();\n\t\t\t}\n\t\t}\n\t}\n\treturn returnValue;\n}\n\nWAADMgmtHandler.stopExecution = function(){\n\t$('#stopModificationButton').attr('onclick', '');\t//to prevent further calls\n\tAjaxAPI.sendRequest({URL:\"WAADBulkMgmt.do?methodToCall=stopExecuteLayout&generationId=\"+rvDO.generationId});  //NO I18N\n}\n\nWAADMgmtHandler.exportResult = function(id) {\n\n\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount>0) {\n\t\tvar url = \"WAADBulkMgmt.do?methodToCall=exportResult\";  //NO I18N\n\t\tvar params = new Hashtable();\n\t\tif($('#M365_ACCOUNT').length>0)\n\t\t\tparams.put(\"waadAccId\", $('#M365_ACCOUNT').val()); //NO I18N\n\t\telse if($('#O365_ACCOUNT_SEL_COMPONENT_1').length>0){\n\t\t\tvar selectedOpt = document.getElementById('O365_ACCOUNT_SEL_COMPONENT_1').selectedOptions[0];\n\t\t\tparams.put(\"waadAccId\",selectedOpt.innerText); //NO I18N\n\t\t}\n\t\tparams.put(\"reportType\", id);\t//NO I18N\n\t\tparams.put(\"generationId\", rvDO.generationId);\t//NO I18N\n\t\tparams.put(\"reportName\", window[WAADMgmtHandler.scriptMgmtHandler].getReportName());\n\t\tparams.put(\"customParams\", rvDO.customParams);\t// NO I18N\n\t\tparams.put(\"reportId\", WAADMgmtHandler.reportId);\t//NO I18N\n\t\tCreateFormAndSubmit(url, 'ExportReport', params); //NO I18N\n\t}\n\telse\n\t\tDWRUtil.getMessageString(\"admp.reports.common.alert.no_data_available\",\"\",loc,function(message){ADMPAlert.alert(message);});\n}\n\nWAADMgmtHandler.applyButtonAction = function() {\n\t\n\tif(window[WAADMgmtHandler.scriptMgmtHandler].applyButtonAction)\n\t\twindow[WAADMgmtHandler.scriptMgmtHandler].applyButtonAction();\n\t$('#clearAllId').hide();\n\t$('#selectedObjText').hide();\n\t$('#modifiedObjText').show();\n\t$('#mgmtOBjCount').text('0');\t// NO I18N\n\t// calling mgmt action..\n\tvar url=\"WAADBulkMgmt.do?methodToCall=performAction\";\t//NO I18N\n\tvar inputJson = window[WAADMgmtHandler.scriptMgmtHandler].getInputAsJson();\n\t\n\t$('#submitName').hide();\t// Disabling the action button.\n\t$('#waadAccountSelectionInput').prop('disabled', true);\t// Disabling the O365 account selection combo box\n\t$('#selectedDomainName').prop('disabled', true);\t// Disabling the AD Domain selection combo box\n\t$('#stopModificationButton').show();\t// Showing Stop button\n\tvar selectedObjectsView = rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView;\n\t//var params=\"waadusers=\"+JSON.stringify(WAADMgmtHandler.selectObjectIds)+\"&waadaccid=\"+$('#waadAccountSelectionInput').val()+\"&reportId=\"+WAADMgmtHandler.reportId+\"&inputJson=\"+encodeURIComponent(inputJson)+\"&actionClass=\" + this.mgmtActionClass+\"&selectedObjectsView=\"+selectedObjectsView;\t//NO I18N\n\tvar params =\"\";\n\tif(typeof WAADMgmtHandler.onTheFlyMgmtDetails != 'undefined' && WAADMgmtHandler.onTheFlyMgmtDetails['onTheFlyMgmtReportId'] != null){\n\t\tparams = params + 'onTheFlyMgmtReportId='+WAADMgmtHandler.onTheFlyMgmtDetails['onTheFlyMgmtReportId'];\t//NO I18N\n\t\tparams += \"&generationID=\"+WAADMgmtHandler.onTheFlyMgmtDetails['generationID'];//NO I18N\n\t\tparams += \"&cvcDataId=\"+WAADMgmtHandler.onTheFlyMgmtDetails['cvcDataId'];\n\t\tif(WAADMgmtHandler.onTheFlyMgmtDetails['licFilterDetails']!=null){\n\t\t\tparams += '&o365LicenseFilterApplied=true'; //NO I18N\n\t\t\tparams = params + '&customParams='+rvDO.customParams; //NO I18N\n\t\t}\n\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll){\n\t\t\tif(WAADMgmtHandler.onTheFlyMgmtDetails['checkAll']){\n\t\t\t\tvar otfDeSelectedObjectIds = WAADMgmtHandler.onTheFlyMgmtDetails['deSelectedObjectIds'];\n\t\t\t\tfor(var i=0;i<otfDeSelectedObjectIds.length;i++){\n\t\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.push(otfDeSelectedObjectIds[i]);\n\t\t\t\t}\n\t\t\t}else{\n\t\t\t\tvar otfselectedObjectIds = WAADMgmtHandler.onTheFlyMgmtDetails['selectedObjectIds'];\n\t\t\t\tfor(var i=0;i<otfselectedObjectIds.length;i++){\n\t\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.push(otfselectedObjectIds[i]);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tparams+=\"&checkAll=\"+rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll+\"&deSelectedObjectIds=\"+rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.toJSONString()+\"&selectedObjectIds=\"+rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.toJSONString()+\"&reportId=\"+WAADMgmtHandler.reportId+\"&inputJson=\"+encodeURIComponent(inputJson)+\"&actionClass=\" + this.mgmtActionClass+\"&selectedObjectsView=\"+selectedObjectsView;\t//NO I18N\n\t\n\tif($('#waadAccountSelectionInput').val() != undefined){\n\t\tparams+=\"&waadaccid=\"+$('#waadAccountSelectionInput').val(); //NO I18N\n\t}\n\t\n\tif(selectedObjectsView==2 || selectedObjectsView==3) {\t//if doing mgmt operation in csv view, pass userCreationId and headerJsonArray of current view obj\n\t\tparams = params + '&userCreationID='+rvDO.currentRVObject.currentSubTabObject.currentViewObject.userCreationID;\t//NO I18N\n\t\tparams = params + '&headerJsonArray=['+rvDO.currentRVObject.currentSubTabObject.currentViewObject.headerJsonArray+']';\t//NO I18N\n\t}\n\tif(typeof rvDO.currentRVObject.currentSubTabObject.currentViewObject.o365LicenseFilterApplied != 'undefined' && rvDO.currentRVObject.currentSubTabObject.currentViewObject.o365LicenseFilterApplied != null && rvDO.currentRVObject.currentSubTabObject.currentViewObject.o365LicenseFilterApplied == true && rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll == true) {\n\t\tparams = params + '&o365LicenseFilterApplied='+rvDO.currentRVObject.currentSubTabObject.currentViewObject.o365LicenseFilterApplied; //NO I18N\n\t\tparams = params + '&customParams='+rvDO.customParams; //NO I18N\n\t} \n\tif($('.o365-filter').is(\":visible\") && $('#applyOUFilter').length)// ouFilter is for METracker\n\t\tparams+=\"&ouFilter=true\"; // NO I18N\n\telse\tparams+=\"&ouFilter=false\"; // NO I18N\n\tAjaxAPI.sendRequest({URL:url, PARAMETERS:params, ONSUCCESSFUNC:WAADMgmtHandler.completedMgmtAction, ONFAILUREFUNC:WAADMgmtHandler.completedMgmtAction});//NO I18N\n}\n\nWAADMgmtHandler.showSelectedObjectsView = function() {\n\t$('#checkAllDiv').slideUp();\n\tif($('#selectedUsersDiv').hasClass('bdr-right'))\n\t\t$('#selectedUsersDiv').removeClass('bdr-right');\n\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView!=1 && rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView!=3) {\t//to prevent if user is already in selectedObjectsView\n\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount)>0) {\n\t\t\tvar filterId = rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId;\n\t\t\tvar selObjViewType = 1;\n\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView==2)\n\t\t\t\tselObjViewType = 3;\n\t\t\tResultViewDataModel.showSelectedObjects(filterId, selObjViewType);\n\t\t}\n\t\telse\n\t\t\tDWRUtil.getMessageString(\"admp.mgmt.office365.bulk_mgmt.alert.no_users_selected\",\"\",loc,function(message){ADMPAlert.alert(message);});\n\t}\n}\n\nWAADMgmtHandler.clearSelectedObjects = function() {\n\tDWRUtil.getMessageString(\"admp.mgmt.user_mgmt.confirm.r_u_sure_want_to_reset\",\"\",loc, function(message) {\n\t\tvar callBackSuccess = function() {\n\t\t\t$('#clearAllId').hide();\n\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.reInitSelectedObjects();\n\t\t\t$('#modifiedOBjCount').text(0);\t// NO I18N\n\t\t\t$('#modifiedOBjCount').removeClass('count');\t// NO I18N\n\t\t\t$('#modifiedOBjCount').addClass('modifiedObjectClass');\t// NO I18N\n\t\t\tvar selObjViewType = 0;\n\t\t\tif($(\"input[id^='csvCheckBoxList_']\").length>0)\n\t\t\t\tselObjViewType = 2;\n\t\t\tResultViewDataModel.showSelectedObjects(rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId, selObjViewType);\n\t\t\treturn true;\n\t\t};\n\t\tvar callbackFailure = function() {\t \n\t\t\t$('#RvTableRemoveAll_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).prop('checked', true);\n\t\t\treturn false; \n\t\t};\n\t\tADMPAlert.confirm(message, null, callBackSuccess, callbackFailure);\n\t});//NO I18N\n}\n\nWAADMgmtHandler.selectAllObjectsInPage = function(filterId) {\n\tvar curSelectedCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount);\n\tvar curView = rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView;\n\tif(curView==0 || curView==1) {\n\t\tRVTableView.onSelectOrClearAll(filterId);\n\t} else if(curView==2 || curView==3) {\n\t\tWAADMgmtHandler.csvOnSelectOrClearAll(filterId);\n\t}\n\tif($('#RvTableSelectAll_'+filterId).prop(\"checked\")) {\n\t\t//$('#RvTableSelectAll_'+filterId).parent('div').addClass('checked');\n\t\tif((rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll==false || curSelectedCount==0)&& rvDO.currentRVObject.currentSubTabObject.currentViewObject.searchString.size()==0 && !this.licenseRestricted) {\n\t\t\tvar newSelectedCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount);\n\t\t\tvar totalCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount;\n\t\t\tif(totalCount>newSelectedCount) {\n\t\t\t\t$('#checkAllCountSpan').text(totalCount);\t//NO I18N\n\t\t\t\t$('#checkAllDiv').slideDown();\n\t\t\t\tif($('#selectedUsersDiv').length)\n\t\t\t\t\t$('#selectedUsersDiv').addClass('bdr-right');\n\t\t\t\t//setTimeout(\"$('#checkAllDiv').slideUp()\", 3000);\n\t\t\t}\n\t\t\telse {\n\t\t\t\t$('#checkAllDiv').slideUp();\n\t\t\t}\n\t\t}\n\t} else {\n\t\t//$('#RvTableSelectAll_'+filterId).parent('div').removeClass('checked');\n\t}\n\tWAADMgmtHandler.updateSelectedObjectCount();\n}\n\n//will be called when clicked on the check box of an object in selectObjectsView\nWAADMgmtHandler.addCurrentObjectForRemovalFromSelectedList = function(obj) {\n\tvar selectedId = $(obj).val();\n\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll) {\n\t\tif(!(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.contains(selectedId))) {\n\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.push(selectedId);\n\t\t}\n\t} else {\n\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.contains(selectedId)) {\n\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.remove(selectedId);\n\t\t}\n\t}\n\tvar selectedObjCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount);\n\t$('#modifiedOBjCount').text(selectedObjCount);\t// NO I18N\n\tif(selectedObjCount==0) {\n\t\t$('#clearAllId').hide();\n\t\tvar selObjViewType = 0;\n\t\tif($(\"input[id^='csvCheckBoxList_']\").length>0)\n\t\t\tselObjViewType = 2;\n\t\t$('#modifiedOBjCount').removeClass('count');\t// NO I18N\n\t\t$('#modifiedOBjCount').addClass('modifiedObjectClass');\t// NO I18N\n\t\tResultViewDataModel.showSelectedObjects(rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId, selObjViewType);\n\t}\n\telse {\n\t\tvar selObjViewType = 1;\n\t\tif($(\"input[id^='csvCheckBoxList_']\").length>0)\n\t\t\tselObjViewType = 3;\n\t\t$('#modifiedOBjCount').removeClass('modifiedObjectClass');\t// NO I18N\n\t\t$('#modifiedOBjCount').addClass('count');\t// NO I18N\n\t\tResultViewDataModel.showSelectedObjects(rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId, selObjViewType);\n\t}\n}\n\nWAADMgmtHandler.showAll = function() {\n\tvar selObjViewType = 0;\n\tif($(\"input[id^='csvCheckBoxList_']\").length>0)\n\t\tselObjViewType = 2;\n\tResultViewDataModel.showSelectedObjects(rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId, selObjViewType);\n}\n\nWAADMgmtHandler.clearAll = function() {\n\t$('#clearAllId').hide();\n\t$('#checkAllDiv').slideUp();\n\tif($('#selectedUsersDiv').hasClass('bdr-right'))\n\t\t$('#selectedUsersDiv').removeClass('bdr-right');\n\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.reInitSelectedObjects();\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.checkAllUsers = false;\n\t$('#modifiedOBjCount').text(0);\t// NO I18N\n\t$('#modifiedOBjCount').removeClass('count');\t// NO I18N\n\t$('#modifiedOBjCount').addClass('modifiedObjectClass');\t// NO I18N\n\tvar curView = rvDO.currentRVObject.currentSubTabObject.currentViewObject.selectedObjectsView;\n\tif(curView==1 || curView==3) {\t//to return to normal view when clearAll is clicked in any selected objects view\n\t\tWAADMgmtHandler.showAll();\n\t} else if(curView==0 || curView==2) {\t//for a normal view, have to clear all check boxes present in that page\n\t\t$('input:checkbox[id^=\"CheckBoxList_\"]').prop('checked', false);\n\t\t$('input:checkbox[id^=\"csvCheckBoxList_\"]').prop('checked', false);\n\t\t$('input:checkbox[id^=\"RvTableSelectAll_\"]').prop('checked', false);\n\t\t$('input:checkbox[id^=\"CheckBoxList_\"]').iCheck('update');\n\t\t$('input:checkbox[id^=\"csvCheckBoxList_\"]').iCheck('update');\n\t\t$('input:checkbox[id^=\"RvTableSelectAll_\"]').iCheck('update');\n\t}\n}\n\nWAADMgmtHandler.checkAllObjects = function() {\n\t$('#clearAllId').show();\n\t$('input:checkbox[id^=\"CheckBoxList_\"]').prop('checked', true);\n\t$('input:checkbox[id^=\"csvCheckBoxList_\"]').prop('checked', true);\n\t$('input:checkbox[id^=\"RvTableSelectAll_\"]').prop('checked', true);\n\t$('input:checkbox[id^=\"CheckBoxList_\"]').iCheck('update');\n\t$('input:checkbox[id^=\"csvCheckBoxList_\"]').iCheck('update');\n\t$('input:checkbox[id^=\"RvTableSelectAll_\"]').iCheck('update');\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll = true;\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids = [];\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.checkAllUsers = true;\n\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids = [];\n\t$('#modifiedOBjCount').text(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount));\t// NO I18N\n\t$('#checkAllDiv').slideUp();\n\tif($('#selectedUsersDiv').hasClass('bdr-right'))\n\t\t$('#selectedUsersDiv').removeClass('bdr-right');\n\n\tif($('#modifiedOBjCount').hasClass('.flat-link')) {\n\t\t$('#modifiedOBjCount').removeClass('modifiedObjectClass');\t// NO I18N\n\t\t$('#modifiedOBjCount').addClass('count');\t// NO I18N\n\t}\n}\n\nWAADMgmtHandler.completedMgmtAction = function(response,requestOptions) {\n\tvar jsonText = response.responseText;\n\tif(jsonText){\n\t\trvConfigObject = JSON.parse(jsonText);\n\t\trvDO = new ResultViewDataModel(rvConfigObject);\n\t\tResultViewDataModel.getMultiViewUI();\n\t}\n\t$('#ReportRVC').show();\n}\n\nWAADMgmtHandler.changeWAADAccount = function() {\n\tif(window[WAADMgmtHandler.scriptMgmtHandler].onDomainChange) {\n\t\twindow[WAADMgmtHandler.scriptMgmtHandler].onDomainChange();\t//sometimes cvc should also change based on selected WAAD acc, if thats the case, then implement that in onDomainChange method of component's js file\n\t\treturn;\n\t}\n\tWAADMgmtHandler.loadRVCJsonConfig();\n\tWAADMgmtHandler.reInit();\n}\n\nWAADMgmtHandler.loadRVCJsonConfig = function() {\n\tvar params = \"rvcID=\"+this.rvcId; //NO I18n\n\tparams += \"&reportId=\"+WAADMgmtHandler.reportId; //NO I18n\n\tparams += \"&isMgmt=\"+true; //NO I18n\n\tvar jsonParams = \"{\";\t\t\n\tif((WAADMgmtHandler.reportId==8055 ||  WAADMgmtHandler.reportId==8056) || ($('#selectedDomainName').val()!=-1 && $('.admp-table-action').is(\":visible\"))) {// 8055 - report Id for create o365 user from AD user\n\t\tvar excludeChildSelected = $('#'+FcEscapeUtil.escapeSelectorId(WAADMgmtHandler.getSelectedDomainDN())+'ExcludeChildOU').prop('checked');\t// NO I18N\n\t\tjsonParams += \"\\\"adDomain\\\":\\\"\"+$('#selectedDomainName :selected').text()+\"\\\",\";\t//NO I18N\n\t\tjsonParams += \"\\\"excludeChildOU\\\":\\\"\" + excludeChildSelected + \"\\\",\";\t//NO I18N\n\t\tjsonParams += \"\\\"selectedOUs\\\":[\";\t//NO I18N\n\t\tfor(var ind=0;ind<selOUs.length;++ind) {\n\t\t\tif(ind>0)\n\t\t\t\tjsonParams += \",\";\n\t\t\tjsonParams += selOUs[ind];\n\t\t}\n\t\tjsonParams += \"],\";\n\t\tjsonParams += \"\\\"unSelectedOUs\\\":[\";\t// NO I18N\n\t\tif(!excludeChildSelected) {\n\t\t\tvar unSelObjs = $('#'+FcEscapeUtil.escapeSelectorId(WAADMgmtHandler.getSelectedDomainDN())+'UnSelected option');\t// NO I18N\n\t\t\tvar selectedDomainDn = WAADMgmtHandler.getSelectedDomainDN();\n\t\t\tfor(var indx=0; indx<unSelObjs.length; ++indx) {\n\t\t\t\tif(indx > 0 && $(unSelObjs[indx]).val() != selectedDomainDn) jsonParams += \",\";\t// NO I18N\n\t\t\t\tif($(unSelObjs[indx]).val() != selectedDomainDn)\n\t\t\t\tjsonParams+= FcEscapeUtil.getEncodedJSONStringWithQuotes($(unSelObjs[indx]).val());\t// NO I18N\n\t\t\t}\n\t\t}\n\t\tjsonParams +=\"]\";\t// NO I18N\n\t}\n\telse if($('.admp-table-action').is(\":visible\")){\n\t\tvar domainList = $('#selectedDomainName').find('option');\n\t\tjsonParams += \"\\\"domainList\\\":[\";\t//NO I18N\n\t\tfor(var index = 1; index < domainList.length; ++index) {\n\t\t\tif(index>1)\n\t\t\t\tjsonParams += \",\";\n\t\t\tjsonParams += \"\\\"\" + $(domainList[index]).text() + \"\\\"\";\n\t\t}\n\t\tjsonParams += \"]\";\n\t}\n\tif(WAADMgmtHandler.reportId!=8055&&WAADMgmtHandler.reportId!=8056){// 8055 - report Id for create o365 user from AD user\n\t\tif(jsonParams.length>1)\n\t\t\tjsonParams += \",\";\n\t\tjsonParams += \"\\\"waadAccountId\\\":\\\"\" + $('#waadAccountSelectionInput').val() + \"\\\"\";\t// NO I18N\n\t}\n\tjsonParams += \"}\";\n\t\tparams+=\"&customParams=\" + jsonParams;\t// NO I18N\n\tif($('.table-action-more').is(\":visible\") && $('#applyOUFilter').length && $('#applyOUFilter').val()==1) {\n\t\t// ouFilter is for METracker\n\t\tparams+=\"&ouFilter=true\"; \t// NO I18N\n\t\t$('#applyOUFilter').val(0);\n\t}\n\telse\tparams+=\"&ouFilter=false\"; // NO I18N\n\tAjaxAPI.sendRequest({URL:\"RVCAction.do?methodToCall=getJSONDataForModuleRVC\",PARAMETERS:params,ONSUCCESSFUNC:WAADMgmtHandler.startUpdate});  //NO I18N\n}\n\nWAADMgmtHandler.updateSelectedObjectDetails = function(obj, selectedId, isCSVImport) {\n\tif($(obj).prop('checked')) {\n\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll) {\n\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.contains(selectedId)) {\n\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.remove(selectedId);\n\t\t\t}\n\t\t} else {\n\t\t\tif(!(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.contains(selectedId))) {\n\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.push(selectedId);\n\t\t\t\tWAADMgmtHandler.setSelectAllCheck(isCSVImport);\n\t\t\t}\n\t\t}\n\t} else {\n\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll) {\n\t\t\tif(!(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.contains(selectedId))) {\n\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.push(selectedId);\n\t\t\t}\n\t\t} else {\n\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.contains(selectedId)) {\n\t\t\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.remove(selectedId);\n\t\t\t}\n\t\t}\n\t\t$(\"input[id^='RvTableSelectAll_']\").parent().removeClass('checked');\n        $(\"input[id^='RvTableSelectAll_']\").prop('checked', false);\n\t}\n\tWAADMgmtHandler.updateSelectedObjectCount();\n}\n\nWAADMgmtHandler.setSelectAllCheck = function(isCSVImport){\n\tvar allchecked=true;\n    var count=0;\n\tif(isCSVImport){\n\t\tif($('input:checkbox[name=\"csvBulkCheckBoxList\"]').length < 1){\n\t\t\tallchecked=false;\n\t\t}else{\n\t\t\t$('input:checkbox[name=\"csvBulkCheckBoxList\"]').each(function() {\n\t\t\t\tif($(this).is(':checked') == false){\n\t\t\t\t\tallchecked=false;\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t}else{\n\t\tif($('input:checkbox[name=\"BulkCheckBoxList\"]').length < 1){\n\t\t\tallchecked=false;\n\t\t}else{\n\t\t\t$('input:checkbox[name=\"BulkCheckBoxList\"]').each(function() {\n\t\t\t\tif($(this).is(':checked') == false){\n\t\t\t\t\tallchecked=false;\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t}\n    if(allchecked == true){\n      $(\"input[id^='RvTableSelectAll_']\").parent().addClass('checked');\n      $(\"input[id^='RvTableSelectAll_']\").prop('checked', true);\n    }else{\n      $(\"input[id^='RvTableSelectAll_']\").parent().removeClass('checked');\n      $(\"input[id^='RvTableSelectAll_']\").prop('checked', false);\n    }\n}\n\nWAADMgmtHandler.updateSelectedObjectCount = function(){\n\tvar selectedObjCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.getSelectedSidCount(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount);\n\tvar totalCount = rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount;\n\t$('#modifiedOBjCount').text(selectedObjCount);\t// NO I18N\n\t$('#modifiedOBjCount').show();\n\t$('#selectedObjText').show();\n\tif(selectedObjCount>0) {\n\t\t$('#clearAllId').show();\n\t\t$('#modifiedOBjCount').removeClass('modifiedObjectClass');\t// NO I18N\n\t\t$('#modifiedOBjCount').addClass('count');\t// NO I18N\n\t} else {\n\t\t$('#clearAllId').hide();\n\t\t$('#modifiedOBjCount').removeClass('count');\t// NO I18N\n\t\t$('#modifiedOBjCount').addClass('modifiedObjectClass');\t// NO I18N\n\t}\n\tif(totalCount>selectedObjCount) {\n\t\t$('#checkAllCountSpan').text(totalCount);\t//NO I18N\n\t\t$('#checkAllDiv').slideDown();\n\t\tif($('#selectedUsersDiv').length)\n\t\t\t$('#selectedUsersDiv').addClass('bdr-right');\n\t}\n\telse {\n\t\t$('#checkAllDiv').slideUp();\n\t}\n\t$('#countDiv').show();\n}\n\nWAADMgmtHandler.checkBoxEvent = function(obj) {\n    if(obj.tagName !== \"INPUT\"){\n\t\tobj= obj.event.target.parentElement.querySelector('input'); //NO I18N\n\t}\n\tvar selectedId = $(obj).val();\n\tif($(obj).prop('checked'))\n\t\t$(obj).attr('checked', true);\n\telse\n\t\t$(obj).attr('checked', false);\n\t$(obj).iCheck('update');\n\tWAADMgmtHandler.updateSelectedObjectDetails(obj, selectedId, false);\n}\n\nWAADMgmtHandler.csvCheckBoxEvent = function(obj) {\n    if(obj.tagName !== \"INPUT\"){\n\t\tobj= obj.event.target.parentElement.querySelector('input'); //NO I18N\n\t}\n\tvar selectedId = $(obj).val();\n\tif($(obj).prop('checked'))\n\t\t$(obj).parent('div').addClass('checked');\n\telse\n\t\t$(obj).parent('div').removeClass('checked');\n\tWAADMgmtHandler.updateSelectedObjectDetails(obj, selectedId, true);\n}\n\nWAADMgmtHandler.updateUserSelectedInputs = function(viewType) {\t//if viewType is 0, it is a normal view, if it is 1 it is selectedObjectsView (the view in which user only sees the objects he selected to do mgmt operation on them), if it is 2 it is csv objects view, if it is 3 it is selected objects view in csv\n\t/* if($('#'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId+'_basicsearchtxt').val() == '') {\n\t\t$('#'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId+'_basicsearchtxt').val(WAADMgmtHandler.defaultSearchTxt);\n\t\t$('#'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId+'_basicsearchtxt').css('color', '#cccccc');\n\t} */\n\tif(viewType==1) {\t//selectedObjectsView\n\t\t$('#selectedObjectsMgmt_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).show();\n\t\t$('#mainSearch_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).removeClass(\"search-hide\");\n\t\tWAADMgmtHandler.updateSelectedObjects('CheckBoxList_', viewType, false);\t// NO I18N\n\t}\n\telse if(viewType==2) {\t//csv objects view\n\t\t$('#selectedObjectsMgmt_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).hide();\n\t\t$('#mainSearch_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).addClass(\"search-hide\");\n\t\tWAADMgmtHandler.updateSelectedObjects('csvCheckBoxList_', viewType, true);\t// NO I18N\n\t}\n\telse if(viewType==0) {\t//normalView\n\t\t$('#selectedObjectsMgmt_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).hide();\n\t\t$('#mainSearch_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).removeClass(\"search-hide\");\n\t\tWAADMgmtHandler.updateSelectedObjects('CheckBoxList_', viewType, false);\t// NO I18N\n\t}\n\telse if(viewType==3) {\t//csvselectedobjectsview\n\t\t$('#selectedObjectsMgmt_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).show();\n\t\t$('#mainSearch_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).addClass(\"search-hide\");\n\t\tWAADMgmtHandler.updateSelectedObjects('csvCheckBoxList_', viewType, true);\t// NO I18N\n\t}\n}\n\nWAADMgmtHandler.updateSelectedObjects = function(id, viewType, isCSVImport) {\n\tif(viewType==1 || viewType==3) {\n\t\t//all are checked in selected obj view\n\t\t$('input:checkbox[id^=\"CheckBoxList_\"]').prop('checked', true);\n\t\t$('input:checkbox[id^=\"csvCheckBoxList_\"]').prop('checked', true);\n\t} else if (viewType==0 || viewType==2) {\n\t\t$('input:checkbox[id^='+id+']').each(function() {\n\t\t\tvar curVal = $(this).val();\n\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.checkAll) {\n\t\t\t\tif(!(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.deSelectedSids.contains(curVal))) {\n\t\t\t\t\t$(this).prop('checked', true);\n\t\t\t\t\t$(this).parent('div').addClass('checked');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.sidSelection.selectedSids.contains(curVal)) {\n\t\t\t\t\t$(this).prop('checked', true);\n\t\t\t\t\t$(this).parent('div').addClass('checked');\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\tWAADMgmtHandler.setSelectAllCheck(isCSVImport);\n}\n\nWAADMgmtHandler.startUpdate = function(response,requestOptions) {\n\tvar jsonText = response.responseText;\n\t//console.info(jsonText);\n\tif(jsonText) {\n\t\trvConfigObject = JSON.parse(jsonText);\n\t\tvar o365LicenseFilterApplied = null;\n\t\tvar o365LicenseFilterType = null;\n\t\tvar customFilterType = null;\n\t\tvar o365alfSelected = null;\n\t\tvar advancedFilterType = null;\n\t\tvar licenses = null;\n\t\tif(typeof rvDO != 'undefined' && rvDO != null && typeof rvDO.currentRVObject != 'undefined' && rvDO.currentRVObject != null && typeof rvDO.currentRVObject.currentSubTabObject != 'undefined' && rvDO.currentRVObject.currentSubTabObject != null && typeof rvDO.currentRVObject.currentSubTabObject.currentViewObject != 'undefined' && rvDO.currentRVObject.currentSubTabObject.currentViewObject != null ) {\n\t\t\to365LicenseFilterApplied = rvDO.currentRVObject.currentSubTabObject.currentViewObject.o365LicenseFilterApplied;\n\t\t\tif(typeof o365LicenseFilterApplied != 'undefined' && o365LicenseFilterApplied != null && o365LicenseFilterApplied == true) {\n\t\t\t\trvDO.customParams = JSON.parse(rvDO.customParams);\n\t\t\t\to365LicenseFilterType = rvDO.customParams['o365LicenseFilterType'];\n\t\t\t\tcustomFilterType      = rvDO.customParams['customFilterType'];\n\t\t\t\to365alfSelected       = rvDO.customParams['o365alfSelected'];\n\t\t\t\tadvancedFilterType    = rvDO.customParams['advancedFilterType'];\n\t\t\t\tlicenses              = rvDO.customParams['licenses'];\n\t\t\t}\n\t\t}\n\t\trvDO = new ResultViewDataModel(rvConfigObject);\n\t\tif(typeof o365LicenseFilterApplied != 'undefined' && o365LicenseFilterApplied != null && o365LicenseFilterApplied == true) {\n\t\t\trvDO.customParams = JSON.parse(rvDO.customParams);\n\t\t\tif(typeof o365LicenseFilterType != 'undefined' && o365LicenseFilterType != null) {\n\t\t\t\trvDO.customParams['o365LicenseFilterType'] = o365LicenseFilterType;\n\t\t\t}\n\t\t\tif(typeof customFilterType != 'undefined' && customFilterType != null) {\n\t\t\t\trvDO.customParams['customFilterType'] = customFilterType;\n\t\t\t}\n\t\t\tif(typeof o365alfSelected != 'undefined' && o365alfSelected != null) {\n\t\t\t\trvDO.customParams['o365alfSelected'] = o365alfSelected;\n\t\t\t}\n\t\t\tif(typeof advancedFilterType != 'undefined' && advancedFilterType != null) {\n\t\t\t\trvDO.customParams['advancedFilterType'] = advancedFilterType;\n\t\t\t}\n\t\t\tif(typeof licenses != 'undefined' && licenses != null) {\n\t\t\t\trvDO.customParams['licenses'] = licenses;\n\t\t\t}\n\t\t\trvDO.customParams = JSON.stringify(rvDO.customParams);\n\t\t}\n\t\tif(typeof WAADMgmtHandler.onTheFlyMgmtDetails != 'undefined' && WAADMgmtHandler.onTheFlyMgmtDetails != null && WAADMgmtHandler.onTheFlyMgmtDetails != '') {\n\t\t\trvDO.customParams = JSON.parse(rvDO.customParams);\n\t\t\trvDO.customParams['onTheFlyMgmtDetails'] = WAADMgmtHandler.onTheFlyMgmtDetails;\n\t\t\trvDO.customParams = JSON.stringify(rvDO.customParams);\n\t\t}\n\t\tResultViewDataModel.getMultiViewUI();\n\t\tif(typeof WAADMgmtHandler.onTheFlyMgmtDetails != 'undefined' && WAADMgmtHandler.onTheFlyMgmtDetails != null && WAADMgmtHandler.onTheFlyMgmtDetails != '')\n\t\t\tWAADMgmtHandler.checkAllObjectsForOTFMgmt();\n\n\t}\n}\nWAADMgmtHandler.checkAllObjectsForOTFMgmt = function(){\n\tvar selectAllCheckBox = $('input:checkbox[id^=\"RvTableSelectAll_\"]');\n\tif(typeof rvDO.currentRVObject.currentSubTabObject == 'undefined' || typeof rvDO.currentRVObject.currentSubTabObject.currentViewObject == 'undefined'||selectAllCheckBox.length == 0 ){\n\t\tsetTimeout(function(){WAADMgmtHandler.checkAllObjectsForOTFMgmt();},300);\n\t}\n\telse{\n\t\tWAADMgmtHandler.checkAllObjects();\n\t}\n}\n\nWAADMgmtHandler.validate = function() {\n\t$('#checkAllDiv').slideUp();\n\tif($('#selectedUsersDiv').hasClass('bdr-right'))\n\t\t$('#selectedUsersDiv').removeClass('bdr-right');\n\tvar isValid = WAADMgmtHandler.isPageValid();\n\tif(isValid) {\n\t\t// Only if valid, we will apply.. If not valid corresponding errorMsg will be displayed.\n\t\t// Error Msg is handled in WAADMgmtHandler.isPageValid function itself..\n\t\tif(WAADMgmtHandler.reportId==8055)\n\t\t\tWAADMgmtHandler.getO365Properties();\n\t\telse\n\t\t\tWAADMgmtHandler.applyButtonAction();\n\t\t\n\t}\n}\nWAADMgmtHandler.getO365Properties = function () {\n    var m365Account = $('#M365_ACCOUNT').val();\n\tvar url = \"/ExecuteForm.do?methodToCall=init&operation=bulkMgmt&templateCategoryId=19&m365AccountName=\"+m365Account+\"&domainName=\"+$('#selectedDomainName :selected').text();\n\n\t//CreateAndSubmitForm('ExecuteForm.do',window.name,params);\n  \tAjaxAPI.sendRequest({URL:url, ONSUCCESSFUNC:WAADMgmtHandler.showO365PropertiesSuccess, ONFAILUREFUNC:WAADMgmtHandler.showO365PropertiesFailed});  //NO I18N\n  \t\n\n}\nWAADMgmtHandler.showO365PropertiesSuccess = function(response,requestOptions) {\n\tvar width = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;\n\tvar height =  window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;\n\tvar top = 0;\n\tvar left = 0;\t\t\n\tif(width > 1000) left = (width - 1000)/2;\n\tif(height > 800) top = (height - 800)/2;\n\tDialogBox.showDialog(response.responseText,\"position=absolute,top=\"+top+\", left=\"+left+\", width=1000, ,title=\"+WAADMgmtHandler.selectO365PropsText+\",dialog_className=no,closeOnEscKey=yes,closeButton=yes,draggable=no,modal=yes,freezeLayerBGColor=#000B0B,modal-width=35\", null, null);  //NO I18N\n\t//$(\"#dialogboxClosebutton\").replaceWith('<i class=\"admp-icon icn-close admp-mt-5 admp-mr-5 pull-right\" onclick=\"DialogBox.closeDialog();\"></i>')\n}\nWAADMgmtHandler.showO365PropertiesFailed = function() {\n\n}\nfunction submitLayout() {\n\tvar isValid = WAADMgmtHandler.isPageValid();\n\tif(isValid) {\n\t\tFcLayouts.submitExecuteLayoutWithDuplicateCheck('false')\n\t}\n}\n\nWAADMgmtHandler.updateViewSpecificStyles = function(rvId){ }\n\nWAADMgmtHandler.doPostMgmtActivities = function(){\n\n\t// Displaying Common Error, this call will also delete StatusUpdator object in server, so call must be made\n\tAjaxAPI.sendRequest({URL:\"/WAADBulkMgmt.do?methodToCall=getCommonErrorMessage&generationId=\"+rvDO.generationId, ONSUCCESSFUNC:WAADMgmtHandler.fillCommonErrorMessage }); //NO I18N\n\t$('#resultPageHeaderDiv').show();\n\t$('#exportDiv').show();\n}\n\nWAADMgmtHandler.fillCommonErrorMessage = function(response,requestOptions) {\n\n\tvar jsonObj = JSON.parse(response.responseText);\n\tif(!jsonObj.isAllSucceeded) {\n\t\t$('#commonErrorMsgLink').attr('href', jsonObj.helpLink);\n\t\tADSUtil.slideDown('commonErrorMsgDiv');//NO I18N\n\t\tif(jsonObj.commonErrorMessage.length>0) {\n\t\t\t$('#commonErrorMsg').text(jsonObj.commonErrorMessage);\t//NO I18N\n\t\t\tif(rvDO.currentRVObject.currentSubTabObject.currentViewObject.pageNavigation.totalCount==0) {\n\t\t\t\t$('#emptyStatusMessage_'+rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId).text(jsonObj.commonErrorMessage);\t//NO I18N\n\t\t\t}\n\t\t}\n\t}\n}\n\nWAADMgmtHandler.refreshAndReloadRV = function() {\n\tif($('#loading').css('display')=='none') {\t//to prevent second call\n\t\t$('#submitName').hide();\n\t\t$('#checkAllDiv').slideUp();\n\t\tif($('#selectedUsersDiv').hasClass('bdr-right'))\n\t\t\t$('#selectedUsersDiv').removeClass('bdr-right');\n\t\t$('#loading').show();\n\t\tvar url = \"/WAADBulkMgmt.do?methodToCall=refreshUsers\";\t// NO I18N\n\t\tif(WAADMgmtHandler.reportId==8055||WAADMgmtHandler.reportId==8056)// 8055 - report Id for create o365 user from AD user\n\t\t{\n\t\t\tvar params = \"domainList=[\\\"\"+$('#selectedDomainName :selected').text()+\"\\\"]\";\t// NO I18N\n\t\t}\n\t\telse{\n\t\tvar params = \"WAADAccountId=\" + $('#waadAccountSelectionInput').val();\t//NO I18N\n\t\t\tif($('#applyOUFilter').length){\n\t\t\t\tvar domainList = $('#selectedDomainName').find('option');\n\t\t\t\tparams += \"&domainList=[\";\t//NO I18N\n\t\t\t\tfor(var index = 1; index < domainList.length; ++index) {\n\t\t\t\t\tif(index>1)\n\t\t\t\t\t\tparams += \",\";\n\t\t\t\t\tparams += \"\\\"\" + $(domainList[index]).text() + \"\\\"\";\n\t\t\t\t}\n\t\t\t\tparams += \"]\";\n\t\t\t}\n\t\t}\n\t\tparams+=\"&reportId=\"+WAADMgmtHandler.reportId; //NO I18N\n\t\trvDO.currentRVObject.currentSubTabObject.currentViewObject.resetTotalCount = true;\t//to reset totalCount in server side\n\t\tAjaxAPI.sendRequest({URL:url, PARAMETERS:params, ONSUCCESSFUNC:WAADMgmtHandler.reloadRV, ONFAILUREFUNC:WAADMgmtHandler.reloadRV});\n\t}\n}\n\nWAADMgmtHandler.reloadRV = function(response,requestOptions) {\n\tvar req = response.transport;\n\tvar x = req.responseXML.getElementsByTagName('status');\n\tvar message = x[0].getAttribute(\"message\");\n\tif(message.length==0) {\n\t\t\tWAADMgmtHandler.loadRVCJsonConfig();\n\t}\n\telse {\n\t\tvar filterId = rvDO.currentRVObject.currentSubTabObject.currentViewObject.filterId;\n\t\t$('#emptyStatusMessage_'+filterId).text(message);\t//NO I18N\n\t\t$('#result_'+filterId).hide();\n\t\t$('#header_'+filterId).hide();\n\t\t$('#bottomNavigation_'+filterId).hide();\n\t\t$('#emptyResult_'+filterId).show();\n\t}\n\t$('#loading').hide();\n\t$('#submitName').show();\n}\n\nWAADMgmtHandler.isInputDetailsStateChanged = function() {\n\tvar curShowInputDetails = false;\n\tif($(\"#toggleCVCDisplayDiv\").hasClass(\"pinned\")) {\n\t\tcurShowInputDetails = true;\n\t}\n\tif(WAADMgmtHandler.showInputDetails == curShowInputDetails)\n\t\treturn false;\n\telse\n\t\treturn true;\n}\n\nWAADMgmtHandler.openOUsPopup = function(isSummaryView) {\n\tPopupSelection.openPopup(156, isSummaryView, true);\t\n}\n\nWAADMgmtHandler.getSelectedDomainDNSDispStr = function() {\n\treturn $('#'+FcEscapeUtil.escapeSelectorId(WAADMgmtHandler.getSelectedDomainDN()+'RootUl')).find('li').text();\t// NO I18N\n}\n\nWAADMgmtHandler.getSelectedDomainDN = function() {\n\treturn $('#selectedDomainName').val();\n}\n\nWAADMgmtHandler.onOUSelectionChange = function() {\n\tvar selectedDomainDN = WAADMgmtHandler.getSelectedDomainDN();\n\tvar selectorEscapedDN = FcEscapeUtil.escapeSelectorId(selectedDomainDN);\n\tvar selectedOULIObjs = $('#'+selectorEscapedDN+'Row').find('li span[id=DispValDiv]');\t// NO I18N\n\tselOUs = [];\n\tfor(var indx1 = 0; indx1 < selectedOULIObjs.length; ++indx1) {\n\t\tselOUs.push(FcEscapeUtil.getEncodedJSONStringWithQuotes($(selectedOULIObjs[indx1]).attr('dnVal')));\t// NO I18N\n\t}\n\tWAADMgmtHandler.loadRVCJsonConfig();\n}\n\nWAADMgmtHandler.updateAfterOUChange = function() {\n\tvar selectorEscapedDN = FcEscapeUtil.escapeSelectorId(WAADMgmtHandler.getSelectedDomainDN());\n\tvar selectedOUNamesPreviewTxt = \"\";\n\tvar liList = $('#'+selectorEscapedDN+'Row li');\n\tif(liList.length >0) {\n\t\tvar addToPreview = true;\n\t\tfor(var indx1 = 0; indx1 < liList.length; ++indx1) {\n\t\t\tvar li = liList[indx1];\n\t\t\tvar dnValAndDispVal = $(li).find('[id=DispValDiv]').text();\n\t\t\tif(addToPreview) {\n\t\t\t\tif(selectedOUNamesPreviewTxt.length > 0) selectedOUNamesPreviewTxt = selectedOUNamesPreviewTxt + \", \";\n\t\t\t\tselectedOUNamesPreviewTxt = selectedOUNamesPreviewTxt + dnValAndDispVal;\n\t\t\t\tif(selectedOUNamesPreviewTxt.length >10) {\n\t\t\t\t\tselectedOUNamesPreviewTxt = selectedOUNamesPreviewTxt.substring(0, 10) + \"...\";\n\t\t\t\t\taddToPreview = false;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t$('#'+selectorEscapedDN+'firstOU').text(selectedOUNamesPreviewTxt);\t// NO I18N\n\t} else {\n\t\t$('#'+selectorEscapedDN+'moreOUDiv').hide();\n\t\t$('#allOUsDiv').show();\n\t\t$('#'+selectorEscapedDN+'ExcludeChildOU').prop('checked', false);\n\t}\n\t\n\tvar totalCount = $('#'+selectorEscapedDN+'Row li').length;\n\tvar currentPosition = parseInt($('[id=\"'+selectorEscapedDN+'Navigate\"]').attr('currentPosition'));\n\t\n\tif(totalCount % ReportOUHandler.range == 0 && currentPosition != 0)\t\n\t\tcurrentPosition = currentPosition - ReportOUHandler.range;\n\t\n\tReportOUHandler.redrawSelectedOUDiv(selectorEscapedDN, currentPosition, totalCount);\n\t$('[id=\"'+selectorEscapedDN+'Navigate\"]').attr('totalCount',totalCount);\n\t$('[id=\"'+selectorEscapedDN+'Navigate\"]').attr('currentPosition',currentPosition);\n}\n\nWAADMgmtHandler.onPopupOk = function(){\n\tvar selectedDomainDN = $('#selectedDomainName :selected').val();\t// NO I18N\n\tvar selectedDomainName = $('#selectedDomainName :selected').text();\t// NO I18N\n\tvar selectorEscapedDN = FcEscapeUtil.escapeSelectorId(selectedDomainDN);\n\tvar selectedOUHash = OUSelectionHandler.selectedList.get('5');\n\tvar selectedOUDNs = \"\";\n\tvar selectedOUsLength = 0;\n\tif(selectedOUHash) {\n\t\tselectedOUDNs = selectedOUHash.keys;\n\t\tselectedOUsLength = selectedOUDNs.length;\n\t}\n\t$('#'+selectorEscapedDN+'Row').empty();\n\tvar selectedOUNamesPreviewTxt = \"\";\n\tvar addToPreview = true;\n\tif(selectedOUsLength > ReportOUHandler.range) {\n\t\t$('[id=\"'+selectorEscapedDN+'Navigate\"]').attr('totalCount', selectedOUsLength);\n\t\t$('[id=\"'+selectorEscapedDN+'Navigate\"]').attr('currentPosition', '0')\n\t}\n\tReportOUHandler.redrawSelectedOUDiv(selectorEscapedDN, 0, selectedOUsLength);\n\tvar liDisplayStyle = 'inline-block';\t// NO I18N\n\tfor(var indx1 = 0; indx1 < selectedOUsLength; ++indx1) {\n\t\tvar dnVal = selectedOUDNs[indx1];\n\t\tvar dispVal = selectedOUHash.get(selectedOUDNs[indx1]);\n\t\tvar selectedDomainDispTxt = selectedDomainName;\n\t\tvar maxDispNameLen = 30;\n\t\tif(selectedDomainDispTxt.length > 15 && selectedDomainDispTxt.length <= 30) {\n\t\t\tmaxDispNameLen = 30 - (selectedDomainDispTxt.length - 15);\n\t\t} else if (selectedDomainDispTxt.length > 30) {\n\t\t\tselectedDomainDispTxt = selectedDomainDispTxt.substring(0, 27) + \"...\";\n\t\t\tmaxDispNameLen = 18;\n\t\t}\n\t\tvar dispValTxt = dispVal;\n\t\tif(dispValTxt.length > maxDispNameLen)\n\t\t\tdispValTxt = dispValTxt.substring(0,maxDispNameLen-3) + \"...\";\n\t\tvar dnValAndDispVal = dispValTxt + \"[\" + selectedDomainDispTxt + \"]\";\n\t\tif(dnVal == WAADMgmtHandler.getSelectedDomainDN()) {\n\t\t\tdnValAndDispVal = WAADMgmtHandler.getSelectedDomainDNSDispStr();\n\t\t}\n\t\tif(indx1 == ReportOUHandler.range)\n\t\t\tliDisplayStyle = 'none';\t// NO I18N\n\t\t$('#'+selectorEscapedDN+'Row').append(\n\t\t\t$('<li>').attr('name', dispVal).attr('id', dnVal).css('display', liDisplayStyle)\t// NO I18N\n\t\t\t.append($('<span>').attr('id','DispValDiv').addClass('ouPath').text(dnValAndDispVal).attr('dnVal', dnVal))\t//NO I18N\n\t\t\t.append($('<span>').attr('id','EmptyDiv').addClass(\"sel_Ous\").css('display','none'))\t// NO I18N\n\t\t\t.append($('<span>').attr('id','RemoveDiv').addClass(\"del_Ous\").css('display','block').click(function() {\t// NO I18N\n\t\t\t\t$('#'+selectorEscapedDN+'UnSelected').append($('<option>').val($(this).closest('li').find('#DispValDiv').attr('dnVal')));\t// NO I18N\n\t\t\t\t$(this).closest('li').remove();\n\t\t\t\tWAADMgmtHandler.updateAfterOUChange();\n\t\t\t\tWAADMgmtHand